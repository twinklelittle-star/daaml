# Recursive
def fibonacci(n):
    if n <= 1:
        return n     
    return fibonacci(n - 1) + fibonacci(n - 2)
     
n = int(input("Enter the number of Fibonacci terms: ")) 
print("Fibonacci Series:") 
for i in range(n):     
    print(fibonacci(i))  
