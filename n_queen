n = int(input("Enter N: "))
board = [[0]*n for i in range(n)]
row = 0
col = 0
while row < n:
    while col < n:
        safe = True
        for i in range(row):
            if board[i][col] == 1:
                safe = False
                break
        i, j = row-1, col-1
        while i >= 0 and j >= 0:
            if board[i][j] == 1:
                safe = False
                break
            i -= 1
            j -= 1
        i, j = row-1, col+1
        while i >= 0 and j < n:
            if board[i][j] == 1:
                safe = False
                break
            i -= 1
            j += 1
        if safe:
            board[row][col] = 1
            row += 1
            col = 0
            break
        col += 1
    else:
        row -= 1
        if row < 0:
            break
        col = board[row].index(1) + 1
        board[row][col-1] = 0
if row == n:
    print("Final N-Queens Matrix:")
    for r in board:
        print(*r)
else:
    print("No solution exists.")
